<view class="page tutor-page">
  <view class="header">
    <text class="eyebrow">智能答疑</text>
    <text class="title">Python 循环结构答疑</text>
    <text class="subtitle">回答尽量绑定课程知识库；不确定时建议查看课程资料或咨询教师。</text>
  </view>

  <view class="section">
    <view class="chip-row">
      <button class="button-secondary example-btn" wx:for="{{examples}}" wx:key="*this" data-question="{{item}}" bindtap="useExample">{{item}}</button>
    </view>
    <button class="button-secondary script-button" bindtap="generateScript">生成讲解脚本</button>
    <view wx:if="{{scriptMessage}}" class="card script-panel"><text class="body-text">{{scriptMessage}}</text></view>
  </view>

  <view class="section chat-list">
    <view class="card message-card {{item.role === 'user' ? 'user-message' : 'ai-message'}}" wx:for="{{messages}}" wx:key="content">
      <text class="primary-text">{{item.role === 'user' ? '我' : 'AI 学伴'}}</text>
      <text class="body-text">{{item.content}}</text>
      <text wx:if="{{item.source}}" class="muted">{{item.source}}</text>
      <view wx:if="{{item.suggestions && item.suggestions.length}}" class="suggestion-list">
        <text class="chip" wx:for="{{item.suggestions}}" wx:for-item="suggestion" wx:key="*this">{{suggestion}}</text>
      </view>
    </view>
  </view>

  <view class="section input-panel">
    <input class="question-input" value="{{question}}" bindinput="onInput" placeholder="输入你的循环结构问题" />
    <button class="button-primary send-btn" loading="{{loading}}" bindtap="sendQuestion">发送</button>
  </view>
</view>

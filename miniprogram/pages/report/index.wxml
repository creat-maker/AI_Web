<view class="page">
  <view class="hero">
    <text class="hero-title">学习报告</text>
    <text class="hero-subtitle">{{student.name}} 的知识点掌握情况、错因诊断和下一步建议。</text>
  </view>

  <view class="section grid">
    <view class="stat">
      <text class="muted">综合评分</text>
      <text class="stat-value">{{report.score}}</text>
    </view>
    <view class="stat">
      <text class="muted">总进度</text>
      <text class="stat-value">{{report.progress}}%</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">AI 总结</view>
    <text class="muted">{{report.summary}}</text>
  </view>

  <view class="section">
    <view class="section-title">知识点掌握情况</view>
    <view class="card" wx:for="{{mastery}}" wx:key="name">
      <view class="split">
        <text class="strong">{{item.name}}</text>
        <text class="tag {{item.status === '已掌握' ? 'success' : item.status === '薄弱' ? 'warning' : 'purple'}}">{{item.status}}</text>
      </view>
      <view class="progress">
        <view class="progress-bar" style="width: {{item.value}}%;"></view>
      </view>
      <text class="muted">掌握率 {{item.value}}%</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">学习建议</view>
    <view class="card" wx:for="{{report.suggestions}}" wx:key="*this">
      <view class="list-item">
        <text class="icon-box">{{index + 1}}</text>
        <text class="muted">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">薄弱点提醒</view>
    <view class="card" wx:for="{{weakPoints}}" wx:key="*this">
      <text class="muted">{{item}}</text>
    </view>
  </view>

  <view class="button-primary" bindtap="goQuiz">查看练习错因</view>
</view>

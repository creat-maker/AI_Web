.tutor-page {
  overflow-x: hidden;
  padding: 22rpx 24rpx 190rpx;
  padding-top: calc(22rpx + constant(safe-area-inset-top));
  padding-top: calc(22rpx + env(safe-area-inset-top));
  padding-bottom: calc(190rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f5f8ff 0%, #f7faff 48%, #ffffff 100%);
}

.tutor-header {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid rgba(47, 107, 255, 0.10);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 36rpx rgba(47, 107, 255, 0.08);
}

.header-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.header-kicker {
  color: #2f6bff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.header-title {
  margin-top: 8rpx;
  color: #152033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.header-subtitle {
  margin-top: 10rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.55;
}

.status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(47, 107, 255, 0.08);
  color: #2f6bff;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.quick-area {
  margin-top: 24rpx;
}

.quick-label {
  display: block;
  color: #152033;
  font-size: 24rpx;
  font-weight: 800;
}

.quick-scroll {
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.quick-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-width: 100%;
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 420rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #2f6bff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: nowrap;
}

.script-panel {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(47, 107, 255, 0.10);
  border-radius: 22rpx;
  background: rgba(238, 245, 255, 0.74);
}

.script-label {
  color: #2f6bff;
  font-size: 22rpx;
  font-weight: 800;
}

.script-text {
  color: #344054;
  font-size: 25rpx;
  line-height: 1.6;
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 28rpx;
}

.chat-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  width: 100%;
  min-width: 0;
}

.user-message {
  justify-content: flex-end;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  overflow: hidden;
  border-radius: 20rpx;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.ai-avatar {
  background: #eaf2ff;
  color: #2f6bff;
}

.user-avatar {
  background: linear-gradient(135deg, #2f6bff, #6b4df6);
  color: #ffffff;
}

.bubble {
  min-width: 0;
  max-width: 86%;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(47, 107, 255, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(47, 107, 255, 0.07);
}

.user-message .bubble {
  max-width: 72%;
  border: 0;
  background: linear-gradient(135deg, #2f6bff 0%, #6b4df6 100%);
  box-shadow: 0 14rpx 30rpx rgba(47, 107, 255, 0.20);
}

.bubble-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.bubble-speaker {
  color: #2f6bff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.3;
}

.bubble-tag {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(47, 107, 255, 0.08);
  color: #2f6bff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.user-message .bubble-speaker {
  color: rgba(255, 255, 255, 0.92);
}

.bubble-text {
  display: block;
  margin-top: 10rpx;
  color: #152033;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-all;
  overflow-wrap: break-word;
}

.user-message .bubble-text {
  color: #ffffff;
}

.source-label {
  display: block;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(47, 107, 255, 0.08);
  color: #667085;
  font-size: 22rpx;
  line-height: 1.55;
  word-break: break-all;
}

.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #2f6bff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: normal;
}

.loading-bubble {
  opacity: 0.92;
}

.chat-bottom {
  height: 2rpx;
}

.input-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 24rpx 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid rgba(47, 107, 255, 0.10);
  box-shadow: 0 -10rpx 30rpx rgba(21, 32, 51, 0.06);
  z-index: 20;
}

.question-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f0f4fb;
  color: #152033;
  font-size: 26rpx;
}

.send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f6bff, #6b4df6);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 12rpx 24rpx rgba(47, 107, 255, 0.22);
}

.send-btn-disabled {
  opacity: 0.46;
  box-shadow: none;
}

button[disabled].send-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #8fb0ff, #a799f8);
}

.search-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.search-card input,
.picker-value {
  min-height: 78rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: #f5f7fb;
  color: #162033;
  font-size: 26rpx;
  line-height: 78rpx;
}

.resource-card .muted,
.resource-card .body-text {
  display: block;
  margin-top: 12rpx;
}

.resource-note {
  display: block;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f5f8ff;
  color: #2459bd;
  font-size: 25rpx;
  line-height: 1.5;
}

.practice-btn,
.task-added-btn {
  margin-top: 18rpx;
}

.task-added-btn {
  background: #e7f8ef;
  color: #087443;
}

.action-grid {
  display: flex;
  gap: 24rpx;
}

.action-grid button {
  flex: 1;
}

<view class="page">
  <view class="hero">
    <text class="hero-title">个性化学习路径</text>
    <text class="hero-subtitle">{{student.goal}}</text>
  </view>

  <view class="section">
    <view class="section-title">阶段进度</view>
    <view class="path-card card" wx:for="{{learningPath}}" wx:key="title">
      <view class="list-item">
        <text class="path-index">{{index + 1}}</text>
        <view class="path-content">
          <view class="split">
            <text class="strong">{{item.title}}</text>
            <text class="tag {{item.status === '已完成' ? 'success' : item.status === '进行中' ? 'purple' : ''}}">{{item.status}}</text>
          </view>
          <text class="muted">{{item.desc}}</text>
          <view class="progress">
            <view class="progress-bar" style="width: {{item.percent}}%;"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

.tutor-page {
  padding-bottom: 210rpx;
  padding-bottom: calc(210rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.example-btn {
  width: auto;
  min-height: 70rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.message-card .body-text,
.message-card .muted {
  display: block;
  margin-top: 10rpx;
}

.user-message {
  background: #eaf1ff;
}

.ai-message {
  background: #ffffff;
}

.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.script-button {
  margin-top: 16rpx;
}

.script-panel {
  margin-top: 16rpx;
  background: #f5f8ff;
}

.input-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx 28rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e4e7ec;
}

.question-input {
  flex: 1;
  min-height: 82rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f5f7fb;
  color: #162033;
  font-size: 26rpx;
}

.send-btn {
  width: 136rpx;
}

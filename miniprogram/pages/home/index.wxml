<view class="page">
  <view class="header cockpit-banner">
    <text class="eyebrow">学生学习驾驶舱</text>
    <text class="title">你好，{{studentName}}</text>
    <text class="subtitle">当前学习课程：{{course}}。系统发现你在循环结构上还需要加强。</text>
    <view class="cockpit-meta">
      <view class="meta-item">
        <text class="meta-label">当前章节</text>
        <text class="meta-value">循环结构</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">综合进度</text>
        <text class="meta-value">{{progress}}%</text>
      </view>
    </view>
    <view class="advice-strip">
      <text class="advice-label">今日建议</text>
      <text class="advice-text">{{todayAdvice}}</text>
    </view>
    <button class="button-primary start-btn" data-path="/pages/path/index" bindtap="goPage">开始今日补弱任务</button>
  </view>

  <view class="section grid-2">
    <view class="stat-card" wx:for="{{stats}}" wx:key="label">
      <text class="stat-label">{{item.label}}</text>
      <text class="stat-value">{{item.value}}</text>
    </view>
  </view>

  <view class="section natural-card-list">
    <view class="natural-card" wx:for="{{homeCards}}" wx:key="title" data-path="{{item.path}}" bindtap="goPage">
      <view class="row">
        <text class="natural-title">{{item.title}}</text>
        <text class="tag">{{item.label}}</text>
      </view>
      <text class="natural-content">{{item.content}}</text>
      <text class="natural-action">{{item.action}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">薄弱知识点</text>
      <text class="tag">持续跟踪</text>
    </view>
    <view class="card">
      <view class="chip-row weak-row">
        <text class="chip" wx:for="{{weakPoints}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">今日学习任务</text></view>
    <view class="card" wx:for="{{tasks}}" wx:key="title">
      <view class="row">
        <view class="col">
          <text class="primary-text">{{item.title}}</text>
          <text class="muted">{{item.detail}}</text>
        </view>
        <text class="tag">{{item.status}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">推荐资源</text><text class="tag">循环结构</text></view>
    <view class="card" wx:for="{{resources}}" wx:key="title">
      <view class="row">
        <view class="col">
          <text class="primary-text">{{item.title}}</text>
          <text class="muted">{{item.type}} / {{item.duration}}</text>
        </view>
        <text class="tag">{{item.icon}}</text>
      </view>
      <text class="body-text">{{item.reason}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">AI 学习建议</text></view>
    <view class="card">
      <text class="body-text">{{aiAdvice}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">快捷入口</text></view>
    <view class="grid-2">
      <button wx:for="{{shortcuts}}" wx:key="name" data-path="{{item.path}}" bindtap="goPage" class="{{item.style === 'primary' ? 'button-primary' : 'button-secondary'}}">{{item.name}}</button>
    </view>
  </view>
</view>

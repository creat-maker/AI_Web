<view class="page">
  <view class="header">
    <view class="eyebrow">{{student.course}}</view>
    <view class="title">{{pathTitle}}</view>
    <view class="subtitle">{{updateMessage}}</view>
  </view>

  <view class="stage-list">
    <view wx:for="{{learningPath}}" wx:key="id" class="stage">
      <view class="stage-top">
        <text class="stage-index">{{item.id}}</text>
        <view class="stage-main">
          <view class="stage-title">{{item.title}}</view>
          <view class="stage-status">{{item.status}}</view>
        </view>
      </view>
      <view class="stage-desc">{{item.description}}</view>
      <view class="stage-meta">任务：{{item.task}}</view>
      <view class="stage-meta">资源：{{item.resourceText}}</view>
    </view>
  </view>

  <view class="adjust-panel">
    <view class="panel-title">测评后的路径调整</view>
    <view class="adjust-row">是否调整：{{adjustment.adjustedText}}</view>
    <view class="adjust-row">调整原因：{{adjustment.reason}}</view>
    <view class="adjust-row">新增任务：{{adjustment.added_tasks}}</view>
    <view class="adjust-row">推荐资源：{{adjustment.recommended_resources}}</view>
    <view class="adjust-row">下一步建议：{{adjustment.next_step}}</view>
  </view>

  <view class="actions">
    <button bindtap="goResources">查看推荐资源</button>
    <button class="secondary" bindtap="goQuiz">进入测验评价</button>
  </view>
</view>

<view class="page">
  <view class="hero">
    <view class="brand">EduMind Studio 学生端</view>
    <view class="title">{{positioning}}</view>
    <view class="subtitle">{{subtitle}}</view>
    <view class="flow">{{flowText}}</view>
  </view>

  <view class="stat-grid">
    <view class="stat">
      <text class="stat-label">当前章节</text>
      <text class="stat-value">{{stats.chapter}}</text>
    </view>
    <view class="stat">
      <text class="stat-label">学习进度</text>
      <text class="stat-value">{{stats.progress}}</text>
    </view>
    <view class="stat">
      <text class="stat-label">正确率</text>
      <text class="stat-value">{{stats.accuracy}}</text>
    </view>
    <view class="stat">
      <text class="stat-label">推荐资源数</text>
      <text class="stat-value">{{stats.resourceCount}}</text>
    </view>
  </view>

  <view class="section-title">学习闭环入口</view>
  <view class="entry-grid">
    <button
      wx:for="{{entries}}"
      wx:key="name"
      class="entry"
      bindtap="goPage"
      data-path="{{item.path}}"
    >
      <text class="entry-name">{{item.name}}</text>
      <text class="entry-desc">{{item.desc}}</text>
    </button>
  </view>

  <view class="panel">
    <view class="panel-title">今日学习重点</view>
    <view class="task-name">{{currentTask.title}}</view>
    <view class="task-desc">{{currentTask.description}}</view>
    <view class="panel-meta">推荐资源：{{resourceCount}} 项 · 报告正确率：{{reportAccuracy}}</view>
    <view class="panel-note">{{reportSummary}}</view>
  </view>
</view>

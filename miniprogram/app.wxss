page {
  min-height: 100%;
  background: #f6f8fc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 44rpx;
}

.hero {
  border-radius: 28rpx;
  padding: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8, #7c3aed);
  box-shadow: 0 18rpx 40rpx rgba(37, 99, 235, 0.18);
}

.hero-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  line-height: 1.55;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid #e2e8f0;
  border-radius: 22rpx;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.card + .card {
  margin-top: 18rpx;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.strong {
  color: #0f172a;
  font-weight: 800;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.stat {
  border-radius: 20rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  color: #1d4ed8;
  font-size: 40rpx;
  font-weight: 800;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #1e40af;
  background: #dbeafe;
  font-size: 22rpx;
  font-weight: 700;
}

.tag.success {
  color: #166534;
  background: #dcfce7;
}

.tag.warning {
  color: #92400e;
  background: #fef3c7;
}

.tag.purple {
  color: #5b21b6;
  background: #ede9fe;
}

.button-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  font-size: 26rpx;
  font-weight: 800;
}

.progress {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
}

.list-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.icon-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8, #7c3aed);
  font-size: 26rpx;
  font-weight: 800;
}

.split {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
}

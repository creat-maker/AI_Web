page {
  min-height: 100%;
  background: #f5f7fb;
  color: #162033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  padding-top: calc(32rpx + constant(safe-area-inset-top));
  padding-top: calc(32rpx + env(safe-area-inset-top));
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f5f7fb;
}

.header {
  padding: 32rpx;
  border-radius: 28rpx;
  background: #2f6fed;
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(47, 111, 237, 0.22);
}

.eyebrow {
  display: block;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  font-weight: 800;
}

.title {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.28;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 27rpx;
  line-height: 1.55;
}

.section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title {
  color: #162033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(16, 24, 40, 0.06);
}

.card:first-child {
  margin-top: 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.col {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.primary-text {
  color: #162033;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.body-text {
  color: #162033;
  font-size: 27rpx;
  line-height: 1.65;
}

.muted {
  color: #475467;
  font-size: 26rpx;
  line-height: 1.55;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: #2f6fed;
  font-size: 24rpx;
  font-weight: 850;
  white-space: nowrap;
}

.tag-success {
  background: #e7f8ef;
  color: #087443;
}

.tag-warning {
  background: #fff4df;
  color: #9a5b00;
}

.tag-muted {
  background: #eef2f6;
  color: #475467;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.grid-2 > view,
.grid-2 > button {
  width: calc((100% - 24rpx) / 2);
}

.stat-card {
  min-height: 146rpx;
  padding: 24rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(16, 24, 40, 0.05);
}

.stat-label {
  color: #475467;
  font-size: 26rpx;
  font-weight: 800;
}

.stat-value {
  display: block;
  margin-top: 14rpx;
  color: #2f6fed;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.1;
}

.progress {
  height: 16rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e4e7ec;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #2f6fed;
}

.button-primary,
.button-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.2;
}

.button-primary {
  color: #ffffff;
  background: #2f6fed;
}

.button-secondary {
  color: #2f6fed;
  background: #eaf1ff;
}

button::after {
  border: 0;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: #2f6fed;
  font-size: 25rpx;
  font-weight: 850;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #e4e7ec;
}

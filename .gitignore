# Environment files
.env
.env.*
!.env.example
!**/.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache / tooling
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
*.egg-info/

# Node / frontend artifacts
node_modules/
dist/
build/
.vite/
.cache/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Databases
*.sqlite
*.sqlite3
*.db
*.db-journal

# Runtime storage
storage/**
backend/storage/**
!storage/
!storage/uploads/
!storage/reports/
!storage/chroma/
!storage/logs/

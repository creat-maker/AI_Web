<view class="page">
  <view class="hero">
    <text class="hero-title">AI 资源推荐</text>
    <text class="hero-subtitle">根据薄弱点匹配微课、讲义、案例和练习材料。</text>
  </view>

  <view class="section">
    <view class="section-title">
      <text>5 类资源包</text>
      <text class="tag {{packFromBackend ? 'success' : 'warning'}}">{{packFromBackend ? '后端生成' : '本地演示'}}</text>
    </view>
    <view class="card resource-pack-card" wx:for="{{resourcePack.resources}}" wx:key="resourceType">
      <view class="split">
        <view>
          <text class="strong">{{item.resourceType}}</text>
          <text class="muted">{{item.title}}</text>
        </view>
        <text class="tag purple">{{item.difficulty}}</text>
      </view>
      <view class="reason">{{item.content}}</view>
      <text class="muted">生成原因：{{item.reason}}</text>
      <view class="point-row">
        <text class="tag" wx:for="{{item.relatedKnowledgePoints}}" wx:for-item="point" wx:key="*this">{{point}}</text>
      </view>
      <text class="muted">预计 {{item.estimatedMinutes}} 分钟</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">推荐资源</view>
    <view class="card resource-card" wx:for="{{recommendedResources}}" wx:key="title">
      <view class="split">
        <view class="list-item">
          <text class="icon-box">{{item.icon}}</text>
          <view>
            <text class="strong">{{item.title}}</text>
            <text class="muted">{{item.course}} · {{item.type}} · {{item.duration}}</text>
          </view>
        </view>
        <text class="tag purple">推荐</text>
      </view>
      <view class="reason">{{item.reason}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">匹配薄弱点</view>
    <view class="card" wx:for="{{weakPoints}}" wx:key="*this">
      <text class="muted">{{item}}</text>
    </view>
  </view>
</view>

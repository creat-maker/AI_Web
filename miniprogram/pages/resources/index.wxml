<view class="page">
  <view class="header">
    <text class="eyebrow">个性化补弱资源包</text>
    <text class="title">{{pack.packageTitle}}</text>
    <text class="subtitle">课程：{{pack.courseName}}。覆盖 while 循环、循环嵌套和 break / continue。</text>
  </view>

  <view class="section grid-2">
    <view class="stat-card">
      <text class="stat-label">资源数量</text>
      <text class="stat-value">{{pack.resourceCount}} 类</text>
    </view>
    <view class="stat-card">
      <text class="stat-label">审核状态</text>
      <text class="stat-value">通过</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">薄弱点覆盖</text></view>
    <view class="card">
      <view class="chip-row">
        <text class="chip" wx:for="{{pack.weakPoints}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">生成资源</text></view>
    <view class="card" wx:for="{{pack.resources}}" wx:key="title">
      <view class="row">
        <view class="col">
          <text class="primary-text">{{item.title}}</text>
          <text class="muted">{{item.resourceType}} / {{item.difficulty}} / {{item.estimatedMinutes}} 分钟</text>
        </view>
        <text class="tag">{{item.resourceType}}</text>
      </view>
      <text class="body-text">{{item.content}}</text>
      <text class="muted">推荐原因：{{item.reason}}</text>
      <button class="{{item.joined ? 'button-secondary task-added-btn' : 'button-secondary practice-btn'}}" data-index="{{index}}" bindtap="addResourceTask">{{item.taskText}}</button>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">推荐学习顺序</text></view>
    <view class="card" wx:for="{{recommendedResources}}" wx:key="title">
      <text class="primary-text">{{item.title}}</text>
      <text class="muted">{{item.type}} / {{item.duration}}</text>
      <text class="body-text">{{item.reason}}</text>
    </view>
  </view>

  <view class="section action-grid">
    <button class="{{taskJoined ? 'button-secondary task-added-btn' : 'button-secondary'}}" bindtap="pushPack">{{statusText}}</button>
    <button class="button-primary" bindtap="goTutor">去问 AI 学伴</button>
  </view>
</view>

<view class="page">
  <view class="header">
    <text class="eyebrow">一人一堂学习路径</text>
    <text class="title">{{pathTitle}}</text>
    <text class="subtitle">系统已根据你的学习情况生成个性化路径，建议优先完成 while 循环专项练习，再推进 break / continue 和循环嵌套。</text>
    <text class="subtitle">{{updateMessage}}</text>
  </view>

  <view class="section">
    <view class="card" wx:for="{{learningPath}}" wx:key="title">
      <view class="row">
        <view class="col">
          <text class="primary-text">{{item.title}}</text>
          <text class="muted">{{item.profileType}}</text>
        </view>
        <text class="tag">{{item.status}}</text>
      </view>
      <view class="progress"><view class="progress-bar" style="width: {{item.percent}}%;"></view></view>
      <text class="body-text">目标：{{item.goal}}</text>
      <text class="body-text">知识点：{{item.knowledge}}</text>
      <text class="body-text">资源：{{item.resource}}</text>
      <text class="body-text">练习：{{item.practice}}</text>
      <text class="muted">AI 建议：{{item.aiAdvice}}</text>
    </view>
  </view>

  <view class="section action-grid">
    <button class="button-primary" bindtap="goResources">查看个性化资源包</button>
  </view>
</view>

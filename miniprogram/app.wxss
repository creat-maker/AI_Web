page {
  min-height: 100%;
  background: #f6f8ff;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-top: calc(28rpx + constant(safe-area-inset-top));
  padding-top: calc(28rpx + env(safe-area-inset-top));
  padding-bottom: calc(56rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f4f8ff 0%, #ffffff 44%, #f7f9ff 100%);
}

.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 34rpx;
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(37, 99, 235, 0.18);
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -64rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
}

.glass-card {
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 28rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 38rpx rgba(15, 23, 42, 0.08);
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 34rpx 0 18rpx;
}

.section-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.28;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.eyebrow {
  display: block;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.title {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.22;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  line-height: 1.62;
}

.primary-text {
  display: block;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.body-text {
  display: block;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.72;
}

.muted {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.62;
}

.pill,
.tag,
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.tag-success {
  background: #e9fbf2;
  color: #047857;
}

.tag-warning {
  background: #fff7e6;
  color: #a15c00;
}

.tag-purple {
  background: #f3e8ff;
  color: #7c3aed;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.primary-btn,
.secondary-btn,
.button-primary,
.button-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.primary-btn,
.button-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.22);
}

.secondary-btn,
.button-secondary {
  color: #2563eb;
  background: #eef4ff;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.stat-card {
  min-height: 136rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.stat-label {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 700;
}

.stat-value {
  display: block;
  margin-top: 12rpx;
  color: #1d4ed8;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.12;
}

.progress {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8f0;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2563eb, #7c3aed);
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #e2e8f0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 46rpx 28rpx;
  color: #64748b;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: #eef4ff;
  color: #2563eb;
  font-size: 42rpx;
  font-weight: 900;
}

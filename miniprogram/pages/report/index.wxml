<view class="page">
  <view class="header">
    <text class="eyebrow">学习报告</text>
    <text class="title">{{student.name}} / {{report.title}}</text>
    <text class="subtitle">包含学习摘要、正确率、薄弱点、推荐资源、下一步计划和教师干预建议。</text>
  </view>

  <view class="section grid-2">
    <view class="stat-card"><text class="stat-label">正确率</text><text class="stat-value">{{report.accuracy}}</text></view>
    <view class="stat-card"><text class="stat-label">学习进度</text><text class="stat-value">{{report.progress}}%</text></view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">学习摘要</text></view>
    <view class="card"><text class="body-text">{{report.summary}}</text></view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">报告口径</text><text class="tag tag-success">已同步</text></view>
    <view class="card advice-card" wx:for="{{evaluationItems}}" wx:key="title">
      <text class="primary-text">{{item.title}}</text>
      <text class="body-text">{{item.detail}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">薄弱点</text></view>
    <view class="card">
      <view class="chip-row"><text class="chip" wx:for="{{report.weakPoints}}" wx:key="*this">{{item}}</text></view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">推荐资源</text></view>
    <view class="card advice-card" wx:for="{{report.recommendedResources}}" wx:key="*this">
      <text class="body-text">{{index + 1}}. {{item}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">下一步学习计划</text></view>
    <view class="card advice-card" wx:for="{{report.nextPlan}}" wx:key="*this">
      <text class="body-text">{{index + 1}}. {{item}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">教师干预建议</text></view>
    <view class="card"><text class="body-text">{{report.teacherAdvice}}</text></view>
  </view>

  <view class="section">
    <view class="card export-card"><text class="body-text">{{report.exportNote}}</text></view>
  </view>

  <view class="section action-grid">
    <button class="button-secondary" bindtap="goQuiz">进入专项测验</button>
    <button class="button-primary" bindtap="goTutor">咨询智能答疑</button>
  </view>
</view>

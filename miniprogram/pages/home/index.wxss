.cockpit-banner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.topic-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 10rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.15);
}

.topic-main,
.topic-sub {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}

.flow-text {
  display: block;
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.55;
}

.entry-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 156rpx;
  margin: 0;
  padding: 22rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: left;
  box-shadow: 0 10rpx 24rpx rgba(16, 24, 40, 0.05);
}

.entry-title {
  color: #162033;
  font-size: 30rpx;
  font-weight: 900;
}

.entry-desc {
  margin-top: 10rpx;
  color: #475467;
  font-size: 24rpx;
  line-height: 1.45;
}

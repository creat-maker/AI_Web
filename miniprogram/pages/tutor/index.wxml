<view class="page">
  <view class="header">
    <text class="eyebrow">诊断式 AI 学伴</text>
    <text class="title">Python 循环结构答疑</text>
    <text class="subtitle">默认问题：为什么我的 while 循环会死循环？回答基于课程知识库和李明画像。</text>
  </view>

  <view class="section">
    <view class="chip-row">
      <button class="button-secondary" wx:for="{{examples}}" wx:key="*this" data-question="{{item}}" bindtap="useExample">{{item}}</button>
    </view>
    <button class="button-secondary script-button" bindtap="generateScript">生成讲解脚本</button>
    <view wx:if="{{scriptMessage}}" class="card script-panel">
      <text class="body-text">{{scriptMessage}}</text>
    </view>
  </view>

  <view class="section chat-list">
    <view class="card message-card {{item.role === 'user' ? 'user-message' : 'ai-message'}}" wx:for="{{messages}}" wx:key="content">
      <text class="primary-text">{{item.role === 'user' ? '我' : 'AI 学伴'}}</text>
      <text class="body-text">{{item.content}}</text>
      <view wx:if="{{item.sections && item.sections.length}}" class="structured-answer">
        <view class="answer-section" wx:for="{{item.sections}}" wx:for-item="section" wx:key="title">
          <text class="answer-title">{{section.title}}</text>
          <text class="answer-item" wx:for="{{section.items}}" wx:for-item="point" wx:key="*this">• {{point}}</text>
        </view>
      </view>
      <text wx:if="{{item.references}}" class="muted">引用依据：{{item.references.knowledgeBase}}</text>
      <text wx:if="{{item.source}}" class="tag">{{item.source}}</text>
    </view>
  </view>

  <view class="section input-panel">
    <input value="{{question}}" bindinput="onInput" placeholder="输入你的循环结构问题" />
    <button class="button-primary" loading="{{loading}}" bindtap="sendQuestion">发送</button>
  </view>
</view>

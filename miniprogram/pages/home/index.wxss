.home-page {
  padding-bottom: 72rpx;
}

.home-hero {
  min-height: 430rpx;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.brand {
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  font-weight: 800;
}

.hero-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.hero-copy {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.hero-stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 30rpx;
}

.hero-stat {
  min-height: 116rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.15);
}

.hero-stat-label {
  display: block;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-stat-value {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
}

.flow-rail {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.flow-step {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 58rpx;
  padding: 8rpx 16rpx 8rpx 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.06);
}

.flow-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 900;
}

.flow-name {
  color: #334155;
  font-size: 23rpx;
  font-weight: 800;
}

.dkvmn-card {
  display: grid;
  gap: 18rpx;
}

.dkvmn-head,
.dkvmn-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
}

.dkvmn-label {
  flex: 0 0 88rpx;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 900;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.entry-card {
  position: relative;
  min-height: 190rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.entry-blue .entry-icon { background: #2563eb; }
.entry-purple .entry-icon { background: #7c3aed; }
.entry-green .entry-icon { background: #059669; }
.entry-cyan .entry-icon { background: #0891b2; }
.entry-orange .entry-icon { background: #ea580c; }
.entry-indigo .entry-icon { background: #4f46e5; }

.entry-main {
  margin-top: 18rpx;
  padding-right: 24rpx;
}

.entry-name {
  display: block;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 900;
}

.entry-desc {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.45;
}

.entry-arrow {
  position: absolute;
  right: 22rpx;
  bottom: 24rpx;
  color: #94a3b8;
  font-size: 42rpx;
  font-weight: 300;
}

.advice-card {
  padding: 30rpx;
}

.advice-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.accuracy-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #eef4ff, #f3e8ff);
  color: #2563eb;
  font-size: 30rpx;
  font-weight: 900;
}

.task-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fbff;
}

.task-label {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
}

.task-name {
  display: block;
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 900;
}

.task-desc {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.55;
}

.advice-list {
  margin-top: 22rpx;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
}

.advice-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 900;
}

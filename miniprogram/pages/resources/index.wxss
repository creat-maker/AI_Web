.generate-btn {
  margin-top: 24rpx;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  opacity: 0.55;
}

.step-active {
  opacity: 1;
}

.step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d0d5dd;
}

.step-active .step-dot {
  background: #2f6fed;
}

.basis-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reason-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.reason-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f5f7fb;
}

.reason-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #2f6fed;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

.reason-text {
  flex: 1;
}

.resource-card .muted {
  display: block;
  margin-top: 12rpx;
}

.practice-btn {
  margin-top: 20rpx;
}

.task-added-btn {
  margin-top: 20rpx;
  background: #e7f8ef;
  color: #087443;
}

.action-grid .task-added-btn {
  margin-top: 0;
}

<view class="page">
  <view class="header">
    <text class="eyebrow">对话式画像构建</text>
    <text class="title">李明的 Python 循环结构画像</text>
    <text class="subtitle">通过对话识别学习目标、当前水平、薄弱点、学习偏好和风险等级。</text>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">画像维度</text></view>
    <view class="grid-2">
      <view class="stat-card" wx:for="{{dimensions}}" wx:key="name">
        <text class="stat-label">{{item.name}}</text>
        <text class="stat-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">识别出的薄弱点</text></view>
    <view class="card">
      <view class="chip-row">
        <text class="chip" wx:for="{{weakPoints}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section chat-list">
    <view class="card message-card {{item.role === 'user' ? 'user-message' : 'ai-message'}}" wx:for="{{messages}}" wx:key="content">
      <text class="primary-text">{{item.role === 'user' ? '李明' : '画像助手'}}</text>
      <text class="body-text">{{item.content}}</text>
    </view>
  </view>

  <view class="section input-panel">
    <input value="{{inputValue}}" bindinput="onInput" placeholder="补充你的循环结构学习困难" />
    <button class="button-primary" bindtap="sendMessage">发送</button>
  </view>

  <view class="section action-grid">
    <button class="button-primary" bindtap="goPath">查看一人一堂路径</button>
  </view>
</view>

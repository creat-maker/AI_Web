.profile-dialog-page {
  padding-bottom: 220rpx;
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.dimension-card {
  margin-top: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(16, 24, 40, 0.05);
}

.dimension-block {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f5f8ff;
}

.block-label {
  display: block;
  margin-bottom: 8rpx;
  color: #2f6fed;
  font-size: 24rpx;
  font-weight: 900;
}

.message-card .body-text {
  display: block;
  margin-top: 8rpx;
}

.user-message {
  background: #eaf1ff;
}

.ai-message {
  background: #ffffff;
}

.input-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  padding: 20rpx 32rpx 28rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e4e7ec;
}

.dialog-input {
  flex: 1;
  min-height: 82rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #f5f7fb;
  color: #162033;
  font-size: 26rpx;
}

.send-btn {
  width: 132rpx;
}

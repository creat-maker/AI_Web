<view class="page profile-dialog-page">
  <view class="header">
    <text class="eyebrow">智能画像构建</text>
    <text class="title">对话式学习画像</text>
    <text class="subtitle">通过自然对话，智能抽取你的学习画像，生成个性化学习方案。</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">抽取进度</text>
      <text class="tag {{filledCount >= 6 ? 'tag-success' : 'tag-warning'}}">{{filledCount}} / 6 维度</text>
    </view>
    <view class="card progress-card">
      <view class="progress"><view class="progress-bar" style="width: {{progressPercent}}%;"></view></view>
      <view class="dimension-list">
        <view class="dim-item {{item.filled ? 'dim-filled' : ''}}" wx:for="{{dimensions}}" wx:key="key">
          <text class="dim-check">{{item.filled ? '✓' : '○'}}</text>
          <text class="dim-label">{{item.label}}</text>
          <text wx:if="{{item.filled}}" class="dim-value">{{item.value}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">对话面板</text>
      <text class="tag {{fromBackend ? 'tag-success' : 'tag-warning'}}">{{fromBackend ? '后端服务' : '离线服务'}}</text>
    </view>
    <view class="card chat-card">
      <view wx:for="{{messages}}" wx:key="index" class="message {{item.role === 'user' ? 'message-user' : 'message-ai'}}">
        <text class="message-role">{{item.role === 'user' ? studentName : 'AI 画像助手'}}</text>
        <text class="message-content">{{item.content}}</text>
      </view>
      <view wx:if="{{loading}}" class="message message-ai">
        <text class="message-role">AI 画像助手</text>
        <text class="message-content">正在分析你的回答并抽取画像维度...</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!completed}}" class="input-panel">
    <textarea class="dialog-input" value="{{userInput}}" bindinput="onInput" maxlength="300" auto-height placeholder="请输入你的回答" />
    <button class="button-primary send-btn" loading="{{loading}}" bindtap="sendMessage">发送</button>
    <button wx:if="{{ready}}" class="button-secondary finish-btn" bindtap="finishDialog">完成画像</button>
  </view>

  <view wx:if="{{completed}}" class="section">
    <view class="section-head"><text class="section-title">画像已生成</text><text class="tag tag-success">已完成</text></view>
    <view class="card">
      <text class="body-text">你的学习画像已构建完成，系统将根据画像生成个性化学习路径和推荐资源。</text>
      <view class="divider"></view>
      <button class="button-primary" bindtap="goPath">查看学习路径</button>
    </view>
  </view>
</view>

<view class="page profile-dialog-page">
  <view class="hero-card profile-hero">
    <text class="eyebrow">{{sourceLabel}}</text>
    <text class="title">对话式学习画像</text>
    <text class="subtitle">通过问答与学习记录形成动态画像，聚焦 {{student.course}} · {{student.chapter}}</text>
  </view>

  <view class="soft-tip">
    <text class="tip-dot"></text>
    <text>{{updateNote}}</text>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">6 维画像报告</view>
        <view class="section-subtitle">每个维度都会影响资源推荐与学习路径</view>
      </view>
      <text class="tag tag-purple">随学更新</text>
    </view>
    <view class="dimension-grid">
      <view class="glass-card dimension-card" wx:for="{{dimensions}}" wx:key="name">
        <view class="dimension-head">
          <view class="dimension-icon">{{item.icon}}</view>
          <view class="dimension-title-wrap">
            <text class="dimension-title">{{item.name}}</text>
            <text class="muted">{{item.explanation}}</text>
          </view>
        </view>
        <view class="dimension-level">
          <text class="tag">{{item.level}}</text>
          <view class="mini-progress"><view class="mini-progress-bar" style="{{item.progressStyle}}"></view></view>
        </view>
        <view class="dimension-block">
          <text class="block-label">当前判断</text>
          <text class="body-text">{{item.judgement}}</text>
        </view>
        <view class="dimension-block strategy-block">
          <text class="block-label">推荐策略</text>
          <text class="body-text">{{item.strategy}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">识别出的薄弱点</view>
        <view class="section-subtitle">用于驱动下一步补强任务</view>
      </view>
    </view>
    <view class="glass-card">
      <view class="chip-row">
        <text class="chip" wx:for="{{weakPoints}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section chat-list">
    <view class="chat-row {{item.bubbleClass}}" wx:for="{{messages}}" wx:key="content">
      <view class="avatar">{{item.avatarText}}</view>
      <view class="bubble">
        <text class="bubble-speaker">{{item.speaker}}</text>
        <text class="bubble-text">{{item.content}}</text>
      </view>
    </view>
  </view>

  <view class="input-panel">
    <input class="dialog-input" value="{{inputValue}}" bindinput="onInput" placeholder="补充你的循环结构学习困难" />
    <button class="send-btn" loading="{{loading}}" bindtap="sendMessage">发送</button>
  </view>

  <button class="floating-path-btn" bindtap="goPath">查看学习路径</button>
</view>
